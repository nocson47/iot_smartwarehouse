# ========================= DATABASE =========================
# PostgreSQL Configuration
# ⚠️ IMPORTANT: Change these values for production!
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=iot_warehouse

# ========================= pgADMIN =========================
# pgAdmin Web UI (Database GUI)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ========================= SERVER =========================
# Go Backend Server
BASE_URL=http://localhost:5000
MQTT_BROKER=tcp://mosquitto:1883

# Optional PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@postgres:5432/iot_warehouse

# ========================= MQTT BROKER =========================
# Mosquitto MQTT Broker (local)
MQTT_USER=iot_device
MQTT_PASS=your_mqtt_password_here

# ⚠️ For production, use secured MQTT broker (HiveMQ, AWS IoT, etc)
# MQTT_BROKER=tcp://broker.hivemq.com:1883

# ========================= SMTP (EMAIL) =========================
# For development: uses MailHog (included in docker-compose)
# For production: configure with real SMTP server
SMTP_HOST=mailhog:1025          # Dev only
SMTP_FROM=noreply@example.com

# Production SMTP example:
# SMTP_HOST=smtp.gmail.com:587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ========================= NETWORKING =========================
# Frontend URL (for CORS, email links, etc)
FRONTEND_URL=http://localhost:3000

# Optional: Cloudflare Tunnel for remote access
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

# ========================= SECURITY =========================
# Session configuration
SESSION_DURATION=24h            # How long sessions are valid

# Rate limiting
MAX_LOGIN_ATTEMPTS=5            # Max failed logins before blocking
LOGIN_ATTEMPT_WINDOW=900s       # Time window for attempt counting
LOGIN_BLOCK_DURATION=1800s      # How long to block IP

